{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "config/index.ts",
        "config/vars.ts",
        "index.ts",
        "provider.ts",
        "resources/azureMicrosoftConnector.ts",
        "resources/azureOidcConnector.ts",
        "resources/client.ts",
        "resources/cognitoOidcConnector.ts",
        "resources/connector.ts",
        "resources/gitHubConnector.ts",
        "resources/gitLabConnector.ts",
        "resources/googleConnector.ts",
        "resources/index.ts",
        "resources/localConnector.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
